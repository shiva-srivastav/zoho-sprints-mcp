# Copy to .env and fill in.
# Alternative: keep it outside the repo and set ZOHO_ENV_FILE to its path.

# Zoho data center TLD. Match your portal URL:
#   sprints.zoho.com -> com   sprints.zoho.in -> in   sprints.zoho.eu -> eu
#   also: com.au, jp, ca, sa, uk
ZOHO_TLD=com

# Self Client from https://api-console.zoho.<TLD>
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Written for you by: npm run auth -- --code <GRANT_CODE>
ZOHO_REFRESH_TOKEN=

# Defaults so tool calls can omit them.
# Team ID: Sprints > Settings > Workspace. Project ID: list_projects tool.
ZOHO_TEAM_ID=
ZOHO_PROJECT_ID=

# From the list_item_meta tool, so create_item needs only a name.
ZOHO_DEFAULT_ITEM_TYPE_ID=
ZOHO_DEFAULT_PRIORITY_ID=

# Optional. From list_sprints; auto-discovered when unset.
ZOHO_BACKLOG_ID=

# Optional. ~1h token that bypasses refresh. Testing only.
# ZOHO_ACCESS_TOKEN=

# Optional. Where the access-token cache lives (default: <project>/.token-cache.json).
# ZOHO_TOKEN_CACHE=
